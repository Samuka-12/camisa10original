{
  "rewrites": [
    {
      "source": "/api/ironpay/webhook(.*)",
      "destination": "/api/ironpay/webhook"
    },
    {
      "source": "/api/webhook(.*)",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

